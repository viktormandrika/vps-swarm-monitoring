GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_DOMAIN=monitoring.example.com

# PostgreSQL exporter.
# If PostgreSQL is another Swarm service on swarm-network:
# POSTGRES_EXPORTER_DATA_SOURCE_URI=postgres:5432/postgres?sslmode=disable
# If PostgreSQL is installed on the host, set an address reachable from containers.
POSTGRES_EXPORTER_DATA_SOURCE_URI=localhost:5432/postgres?sslmode=disable
POSTGRES_EXPORTER_DATA_SOURCE_USER=monitor
POSTGRES_EXPORTER_DATA_SOURCE_PASS=changeme
